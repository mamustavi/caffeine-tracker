{
  "expo": {
    "name": "eluent",
    "slug": "eluent",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eluent",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE8DD"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mamustavi.bevi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EDE8DD"
      },
      "package": "com.mamustavi.bevi"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c803e654-371d-4146-b290-408eba0b9ee7"
      }
    },
    "owner": "mamustavi"
  }
}
